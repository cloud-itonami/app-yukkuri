{;; Repo-root entry point for the clj/cljs twin under `lg-clj/`.
 ;;
 ;; The tree itself, its dependency pins and its `:paths` live in
 ;; `lg-clj/deps.edn`; this file reaches them through `:local/root` rather than
 ;; restating them, so there is exactly one place a dependency sha is written.
 ;;
 ;;   clojure -M:test                       the whole suite, JVM
 ;;   cd lg-clj && clojure -M:test          the same, from inside the tree
 ;;
 ;; The ClojureScript half runs from inside `lg-clj/` (see `lg-clj/run-tests.cljs`);
 ;; nbb takes a classpath rather than a deps.edn, so it has no root form.
 :paths []
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       cloud-itonami/lg-yukkuri {:local/root "lg-clj"}}
 :aliases
 {:test {:extra-paths ["lg-clj/test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "lg-clj/test"]}}}
