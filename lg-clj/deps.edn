{;; lg-yukkuri — clj/cljs twin of the Python LangGraph server (ADR-2606280030).
 ;;
 ;; Scoped to this app only; it does NOT touch the superproject root. The Python
 ;; FastAPI runtime under `../lg/` remains the DEPLOYED runtime and COEXISTS with
 ;; this twin until a human cuts over.
 ;;
 ;; This file replaces the `bb.edn` that used to hold the same two dependencies.
 ;; ADR-2607173000 retired babashka as this workspace's script host, and the
 ;; practical cost of staying on it was concrete rather than stylistic: `kbb -M:test`
 ;; was the ONLY thing that ever ran these `.cljc` sources, babashka is a JVM,
 ;; and so the ClojureScript half of every reader conditional here was dead
 ;; code no runtime had ever loaded. It did not load: see `lg-yukkuri.compat`.
 ;;
 ;; Two runtimes, one suite (`run-tests.cljk` explains the split):
 ;;   kbb --backend sci --classpath "src:test:$(kbb -Spath -M:test)" run-tests.cljk
 ;;   kbb -M:test
 :paths ["src"]

 ;; Pinned at each upstream default branch tip, verified reachable 2026-09-01.
 ;; `json` is a direct dependency (lg-yukkuri.audit / .llm and four graphs call
 ;; `json.compat`) even though langchain would supply it transitively -- what a
 ;; namespace requires, its own deps.edn should name.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.langgraph"}
        io.github.kotoba-lang/langchain
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.langchain"}
        io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.json"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/langgraph
        {:local/root "../../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
                        io.github.kotoba-lang/langchain
        {:local/root "../../../kotoba-lang/kotoba/lib/kotoba.langchain"}
                        io.github.kotoba-lang/json
        {:local/root "../../../kotoba-lang/kotoba/lib/kotoba.json"}}}}}
